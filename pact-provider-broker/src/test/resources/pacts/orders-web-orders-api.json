        "testname": "lab.OrderClientPactTest.readsExistingOrder(MockServer)",
        "text": [

        ]
      },
      "description": "get order 42",
      "key": "512275c2",
      "pending": false,
      "providerStates": [
        {
          "name": "order 42 exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/orders/42"
      },
      "response": {
        "body": {
          "content": {
            "id": 42,
            "status": "NEW"
          },
          "contentType": "application/json; charset=UTF-8",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json; charset=UTF-8"
          ]
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "NEW|PAID|SHIPPED"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json(;\\s?charset=[\\w\\-]+)?"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
